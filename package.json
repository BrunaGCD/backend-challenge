{
  "name": "wagering-processor",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "bun src/main.ts",
    "migrate:up": "bun scripts/migrate.ts up",
    "migrate:down": "bun scripts/migrate.ts down",
    "queues:create": "bun scripts/create-queues.ts",
    "queue:send": "bun scripts/send-wager-message.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src test scripts",
    "test:unit": "bun test test/unit",
    "test:integration": "bun test --preload ./test/support/fresh-database.ts --timeout 60000 test/integration",
    "test:concurrency": "bun test --preload ./test/support/fresh-database.ts --timeout 180000 test/concurrency",
    "test": "bun run test:unit && bun run test:integration && bun run test:concurrency"
  },
  "dependencies": {
    "@aws-sdk/client-sqs": "^3.1154.0",
    "@mikro-orm/core": "7.2.5",
    "@mikro-orm/migrations": "7.2.5",
    "@mikro-orm/postgresql": "7.2.5",
    "@nestjs/common": "11.2.7",
    "@nestjs/core": "11.2.7",
    "@nestjs/platform-express": "11.2.7",
    "canonicalize": "^5.1.0",
    "express": "5.2.1",
    "pino": "10.4.0",
    "prom-client": "15.1.3",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@types/bun": "^1.4.3",
    "@types/express": "5",
    "eslint": "9",
    "typescript": "5",
    "typescript-eslint": "^8.72.0"
  }
}
