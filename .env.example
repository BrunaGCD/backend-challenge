# Todas as variáveis que a aplicação lê (src/config.ts e src/observability/logger.ts), com os padrões do
# código: copiar este arquivo para .env não muda nada até você mudar um valor. O Bun lê o .env sozinho
# quando a aplicação ou os testes rodam fora do Docker; o .env não vai para o Git. As credenciais são
# fictícias, só para o PostgreSQL e o MiniStack locais.

# ----------------------------------------------------------------------------------------------------
# HTTP e logs
# ----------------------------------------------------------------------------------------------------
PORT=3000
LOG_LEVEL=info
# nome da instância em cada linha de log (o compose usa app-1, app-2 e app-3)
INSTANCE_NAME=local
# moedas aceitas na entrada, separadas por vírgula
ACCEPTED_CURRENCIES=BRL
# paginação do GET /wallets/:walletId/ledger
LEDGER_PAGE_DEFAULT_LIMIT=50
LEDGER_PAGE_MAX_LIMIT=100

# ----------------------------------------------------------------------------------------------------
# PostgreSQL
# ----------------------------------------------------------------------------------------------------
DATABASE_URL=postgresql://wagering:wagering@localhost:5432/wagering
DATABASE_POOL_MAX=20
DATABASE_CONNECT_TIMEOUT_MS=3000
DATABASE_IDLE_IN_TRANSACTION_TIMEOUT_MS=10000
# espera pelo lock da wallet: curta no HTTP (alguém espera a resposta; estourou, 503 e o provedor reenvia)
# e maior na fila, no worker e no publisher, onde ninguém espera a resposta e desistir cedo só gasta mais
# uma tentativa. Ordem exigida na subida: lock < statement, e o statement da fila < SQS_VISIBILITY_TIMEOUT_SECONDS.
DATABASE_LOCK_TIMEOUT=2s
DATABASE_STATEMENT_TIMEOUT=5s
DATABASE_BACKGROUND_LOCK_TIMEOUT=10s
DATABASE_BACKGROUND_STATEMENT_TIMEOUT=15s

# ----------------------------------------------------------------------------------------------------
# SQS (MiniStack)
# ----------------------------------------------------------------------------------------------------
SQS_ENDPOINT=http://localhost:4566
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
# timeout das chamadas comuns ao SQS; o long polling usa um cliente próprio, com SQS_WAIT_TIME_SECONDS + 5 s
SQS_CLIENT_TIMEOUT_MS=5000
SQS_INPUT_QUEUE=wager-transactions.fifo
SQS_DEAD_LETTER_QUEUE=wager-transactions-dlq.fifo
SQS_EVENTS_QUEUE=wagering-events.fifo
SQS_VISIBILITY_TIMEOUT_SECONDS=30
SQS_WAIT_TIME_SECONDS=20
# rede de segurança: só gasta recebimento a mensagem que sai das mãos do consumidor (desligamento, processo
# morto, extensão de prazo recusada); a falha transitória tenta de novo no próprio consumidor, sem gastar
SQS_MAX_RECEIVE_COUNT=10

# ----------------------------------------------------------------------------------------------------
# Consumidor da fila de entrada
# ----------------------------------------------------------------------------------------------------
CONSUMER_ENABLED=true
# consumer_name gravado na inbox
CONSUMER_NAME=wager-transactions-consumer
# backoff entre as novas tentativas de uma mensagem com falha transitória
CONSUMER_RETRY_BASE_MS=2000
CONSUMER_RETRY_CAP_MS=60000
# o limite de tentativas: quanto tempo uma mensagem com falha transitória tenta de novo no consumidor,
# contado da primeira falha, antes de ir para a DLQ com RETRY_BUDGET_EXHAUSTED (5 minutos)
CONSUMER_RETRY_BUDGET_MS=300000
# quantas mensagens cada instância segura ao mesmo tempo, somando todas as wallets; a próxima busca sai
# sem esperar as outras terminarem, então uma wallet presa tentando de novo não segura as outras
CONSUMER_MAX_IN_FLIGHT_MESSAGES=10
# no SIGTERM, quanto tempo o consumidor espera as mensagens em andamento terminarem
SHUTDOWN_IN_FLIGHT_TIMEOUT_MS=20000

# ----------------------------------------------------------------------------------------------------
# Worker das transações em PENDING_REFERENCE
# ----------------------------------------------------------------------------------------------------
PENDING_WORKER_ENABLED=true
PENDING_WORKER_INTERVAL_MS=1000
# depois desse prazo sem a referência, a transação vira REJECTED com REFERENCE_NOT_FOUND (10 minutos)
PENDING_REFERENCE_TTL_MS=600000
PENDING_RETRY_BASE_MS=1000
# teto da espera entre tentativas do worker de pendentes: depois que a referência chega, a pendente é
# decidida na próxima tentativa, então espera no máximo isso (mais o intervalo de 1 s do worker)
PENDING_RETRY_CAP_MS=10000

# ----------------------------------------------------------------------------------------------------
# Publisher da outbox
# ----------------------------------------------------------------------------------------------------
OUTBOX_PUBLISHER_ENABLED=true
# varredura quando não há nada para publicar; lote cheio volta na hora
OUTBOX_INTERVAL_MS=500
OUTBOX_BATCH_SIZE=10
OUTBOX_RETRY_BASE_MS=1000
OUTBOX_RETRY_CAP_MS=300000
# não há limite de tentativas; depois deste número, cada falha vira log de erro e conta em wagering_outbox_stuck
OUTBOX_STUCK_AFTER_ATTEMPTS=10

# ----------------------------------------------------------------------------------------------------
# Medidores e laços de fundo
# ----------------------------------------------------------------------------------------------------
# a cada quanto os gauges da outbox e das pendentes, e o tamanho da DLQ, são lidos
OUTBOX_GAUGE_INTERVAL_MS=5000
DLQ_GAUGE_INTERVAL_MS=30000
# laços de fundo (publisher da outbox, worker de pendentes, medidores): depois de falhas seguidas a espera
# dobra a partir do intervalo de cada um, até este teto, e volta ao intervalo normal no primeiro sucesso
BACKGROUND_LOOP_FAILURE_CAP_MS=10000

# ----------------------------------------------------------------------------------------------------
# Só dos testes
# ----------------------------------------------------------------------------------------------------
# onde os testes criam o banco novo de cada execução; sem ela, usam o DATABASE_URL
# TEST_DATABASE_ADMIN_URL=postgresql://wagering:wagering@localhost:5432/wagering
